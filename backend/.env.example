# PhoneToUSB Backend Production Environment Template
# Copy this file to .env and replace with secure values

# Domain & Host Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Security Secrets (Generate random 64-character hex strings)
SECRET_KEY=replace-with-a-random-64-character-production-secret-key
TURN_SECRET=replace-with-same-static-auth-secret-configured-in-coturn

# TURN / STUN Infrastructure
TURN_REALM=turn.yourdomain.com
TURN_SERVERS=turn:turn.yourdomain.com:3478,turns:turn.yourdomain.com:5349
STUN_SERVERS=stun:stun.l.google.com:19302,stun:turn.yourdomain.com:3478

# Rate Limiting & Protection
MAX_PAIRING_ATTEMPTS_PER_MIN=5
MAX_CONNECTIONS_PER_IP=25
RECEIVER_HEARTBEAT_TIMEOUT_SEC=45
PAIRING_TOKEN_TTL_SEC=180
